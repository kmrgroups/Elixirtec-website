// Elixir Tec Corporation platform — core data model, v1
// This is a foundation schema: it covers every entity needed for the
// public site + CMS + RFQ -> quote -> order -> production -> dispatch
// pipeline. Extend individual models as features are built out —
// don't treat this as final/locked.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- AUTH & USERS ----------

enum UserRole {
  SUPER_ADMIN
  WEBSITE_ADMIN
  SALES_MANAGER
  SALES_EXECUTIVE
  ENGINEERING
  PRODUCTION_MANAGER
  QUALITY_MANAGER
  DISPATCH_MANAGER
  HR_MANAGER
  CONTENT_MANAGER
  VIEWER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String?
  role          UserRole  @default(VIEWER)
  isActive      Boolean   @default(true)
  forcePasswordReset Boolean @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  assignedRfqs     Rfq[]              @relation("AssignedRfq")
  quoteVersions    QuoteVersion[]
  productionUpdates ProductionUpdate[]
  auditLogs        AuditLog[]
  sessions         Session[]
  accounts         Account[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- CUSTOMERS (Customer Portal) ----------

model Customer {
  id           String   @id @default(cuid())
  companyName  String
  contactName  String
  email        String   @unique
  passwordHash String?
  phone        String?
  whatsapp     String?
  country      String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  rfqs   Rfq[]
  quotes Quote[]
  orders Order[]
}

// ---------- CMS: PRODUCTS / SERVICES / TAXONOMY ----------

model ProductCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  parentId String?
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  code            String   @unique
  sku             String?
  categoryId      String?
  category        ProductCategory? @relation(fields: [categoryId], references: [id])
  description     String   @db.Text
  detailedContent String?  @db.Text
  specifications  Json?    // technical specs as structured key/value data
  materials       String?
  applications     String?
  featured        Boolean  @default(false)
  status          PublishStatus @default(DRAFT)
  seoTitle        String?
  seoDescription  String?
  images          Media[]  @relation("ProductImages")
  datasheet       Media?   @relation("ProductDatasheet", fields: [datasheetId], references: [id])
  datasheetId     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  content     String?  @db.Text
  benefits    String?
  applications String?
  status      PublishStatus @default(DRAFT)
  images      Media[]  @relation("ServiceImages")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BusinessDivision {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @db.Text
  status      PublishStatus @default(DRAFT)
  sortOrder   Int      @default(0)
}

model Industry {
  id        String @id @default(cuid())
  name      String
  slug      String @unique
  sortOrder Int    @default(0)
}

model Leadership {
  id           String @id @default(cuid())
  name         String
  designation  String
  bio          String? @db.Text
  photoId      String?
  linkedinUrl  String?
  sortOrder    Int    @default(0)
}

model Certification {
  id             String    @id @default(cuid())
  name           String
  certNumber     String?
  issueDate      DateTime?
  expiryDate     DateTime?
  description    String?
  certificateId  String?   // Media id of the cert image/PDF
}

model CaseStudy {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  industry    String?
  challenge   String?  @db.Text
  solution    String?  @db.Text
  result      String?  @db.Text
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
}

model NewsPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  body        String   @db.Text
  status      PublishStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?
}

// ---------- CAREERS ----------

model JobPosting {
  id          String   @id @default(cuid())
  title       String
  department  String?
  location    String?
  employmentType String?
  description String   @db.Text
  status      PublishStatus @default(DRAFT)
  deadline    DateTime?
  applications JobApplication[]
}

model JobApplication {
  id           String   @id @default(cuid())
  jobId        String
  job          JobPosting @relation(fields: [jobId], references: [id])
  name         String
  email        String
  phone        String?
  resumeId     String?
  coverLetter  String?
  status       String   @default("NEW")
  notes        String?
  createdAt    DateTime @default(now())
}

// ---------- MEDIA / CMS PAGES ----------

model Media {
  id        String   @id @default(cuid())
  url       String
  filename  String
  mimeType  String
  sizeBytes Int
  altText   String?
  folder    String?
  uploadedAt DateTime @default(now())

  productImages  Product[] @relation("ProductImages")
  productDatasheets Product[] @relation("ProductDatasheet")
  serviceImages  Service[] @relation("ServiceImages")
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  status    PublishStatus @default(DRAFT)
  seoTitle  String?
  seoDescription String?
  sections  PageSection[]
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero, intro, stats, products, testimonials, cta, ...
  content   Json      // section-specific structured content
  sortOrder Int      @default(0)
  visible   Boolean  @default(true)
}

model SiteSetting {
  key   String @id
  value Json
}

// ---------- RFQ ----------

enum RfqStatus {
  NEW
  RECEIVED
  ASSIGNED
  TECHNICAL_REVIEW
  COMMERCIAL_REVIEW
  AI_QUOTE_GENERATED
  QUOTE_UNDER_REVIEW
  QUOTE_APPROVAL_PENDING
  QUOTE_APPROVED
  QUOTE_SENT
  CUSTOMER_REVIEW
  NEGOTIATION
  QUOTE_REVISED
  CUSTOMER_ACCEPTED
  ORDER_CREATED
  CLOSED
  LOST
}

model Rfq {
  id            String   @id @default(cuid())
  rfqNumber     String   @unique // ETC-RFQ-2026-000001
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id])
  contactName   String
  companyName   String
  email         String
  phone         String?
  whatsapp      String?
  country       String?
  productRef    String?
  quantity      Int?
  material      String?
  specifications String? @db.Text
  requiredDate  DateTime?
  notes         String? @db.Text
  status        RfqStatus @default(NEW)
  priority      String?  @default("NORMAL")
  assignedToId  String?
  assignedTo    User?    @relation("AssignedRfq", fields: [assignedToId], references: [id])
  attachments   RfqAttachment[]
  quotes        Quote[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RfqAttachment {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  url      String
  filename String
  mimeType String
}

// ---------- QUOTATION ----------

enum QuoteStatus {
  AI_DRAFT
  HUMAN_REVIEW
  PENDING_APPROVAL
  APPROVED
  SENT
  REVISED
  ACCEPTED
  REJECTED
}

model Quote {
  id           String   @id @default(cuid())
  quoteNumber  String   @unique
  rfqId        String
  rfq          Rfq      @relation(fields: [rfqId], references: [id])
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  status       QuoteStatus @default(AI_DRAFT)
  currentVersion Int    @default(1)
  aiGenerated  Boolean  @default(false)
  aiReviewNotes Json?   // matched requirement, missing info, warnings — never treated as final
  approvedById String?
  approvedAt   DateTime?
  validUntil   DateTime?
  pdfMediaId   String?
  versions     QuoteVersion[]
  lineItems    QuoteLineItem[]
  order        Order?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model QuoteVersion {
  id         String   @id @default(cuid())
  quoteId    String
  quote      Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  versionNo  Int
  changedById String?
  changedBy  User?    @relation(fields: [changedById], references: [id])
  changes    Json      // { field, oldValue, newValue }[]
  createdAt  DateTime @default(now())
}

model QuoteLineItem {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal @db.Decimal(14, 2)
  taxPercent  Decimal @db.Decimal(5, 2) @default(0)
  notes       String?
}

// ---------- ORDERS & PRODUCTION ----------

model Order {
  id            String   @id @default(cuid())
  orderNumber   String   @unique // ETC-ORD-2026-000001
  quoteId       String   @unique
  quote         Quote    @relation(fields: [quoteId], references: [id])
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id])
  status        String   @default("CONFIRMED")
  deliveryCommitment DateTime?
  createdAt     DateTime @default(now())

  production ProductionOrder?
}

model ProductionOrder {
  id                String   @id @default(cuid())
  orderId           String   @unique
  order             Order    @relation(fields: [orderId], references: [id])
  requiredQuantity  Int
  producedQuantity  Int      @default(0)
  rejectedQuantity  Int      @default(0)
  currentStageId    String?
  currentStage      ProductionStage? @relation(fields: [currentStageId], references: [id])
  status            String   @default("PLANNING") // PLANNING, IN_PROGRESS, DELAYED, COMPLETED
  startDate         DateTime?
  targetDate        DateTime?
  actualCompletionDate DateTime?
  delayReason       String?
  updates           ProductionUpdate[]
  qualityInspections QualityInspection[]
  dispatch          Dispatch?
}

model ProductionStage {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  enabled   Boolean  @default(true)

  productionOrders ProductionOrder[]
}

model ProductionUpdate {
  id               String   @id @default(cuid())
  productionOrderId String
  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageName        String
  quantityCompleted Int     @default(0)
  quantityRejected Int     @default(0)
  machine          String?
  operatorNote     String?
  updatedById      String?
  updatedBy        User?    @relation(fields: [updatedById], references: [id])
  createdAt        DateTime @default(now())
}

model QualityInspection {
  id               String   @id @default(cuid())
  productionOrderId String
  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stage            String   // INCOMING, IN_PROCESS, FINAL
  quantityAccepted Int      @default(0)
  quantityRejected Int      @default(0)
  reportMediaId    String?
  nonConformance   String?
  correctiveAction String?
  createdAt        DateTime @default(now())
}

model Dispatch {
  id               String   @id @default(cuid())
  productionOrderId String  @unique
  productionOrder  ProductionOrder @relation(fields: [productionOrderId], references: [id])
  dispatchDate     DateTime?
  transporter      String?
  trackingNumber   String?
  quantityDispatched Int?
  invoiceRef       String?
  status           String   @default("PENDING") // PENDING, DISPATCHED, IN_TRANSIT, DELIVERED
}

// ---------- NOTIFICATIONS / AUDIT ----------

model Notification {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
}

// ---------- AI KNOWLEDGE BASE / CHATBOT ----------

model KnowledgeBaseDoc {
  id        String   @id @default(cuid())
  title     String
  sourceUrl String?
  mediaId   String?
  content   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ChatbotConversation {
  id         String   @id @default(cuid())
  visitorId  String?
  transcript Json
  escalated  Boolean  @default(false)
  rfqCreatedId String?
  createdAt  DateTime @default(now())
}
