// ============================================================================
// PLATFORM FOUNDATION — multi-tenant corporate website + CMS + RFQ platform
// Phase 1: architecture + database + auth + multi-tenancy
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// PLATFORM-LEVEL (super admin scope — not tied to any single tenant)
// ---------------------------------------------------------------------------

enum PlatformRole {
  SUPER_ADMIN
  PLATFORM_STAFF
}

model PlatformUser {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         PlatformRole @default(PLATFORM_STAFF)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  auditLogs AuditLog[]
}

enum SubscriptionPlan {
  BASIC
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

// The tenant is the root of isolation. Every tenant-owned table below carries
// a tenantId foreign key, and every query in the app layer MUST be scoped by
// the authenticated session's tenantId — this is enforced at the API layer,
// never trusted from client input.
model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique // used for platformdomain.com/<slug> preview + subdomain routing
  name      String
  industry  String?
  status    TenantStatus @default(TRIAL)
  plan      SubscriptionPlan @default(BASIC)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         TenantUser[]
  website       Website?
  products      Product[]
  productCats   ProductCategory[]
  services      Service[]
  verticals     BusinessVertical[]
  processes     Process[]
  equipment     Equipment[]
  certifications Certification[]
  clients       Client[]
  testimonials  Testimonial[]
  leadership    LeadershipProfile[]
  jobs          JobOpening[]
  applications  Application[]
  rfqs          Rfq[]
  quotations    Quotation[]
  socialLinks   SocialLink[]
  locations     Location[]
  contactSubs   ContactSubmission[]
  blogs         BlogPost[]
  notifications Notification[]
  auditLogs     AuditLog[]
  domains       Domain[]
  media         MediaAsset[]

  @@index([status])
}

model Domain {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostname  String   @unique // e.g. customer1.com or customer1.platform.com
  isPrimary Boolean  @default(false)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// TENANT-SCOPED USERS + RBAC
// ---------------------------------------------------------------------------

enum TenantRole {
  OWNER
  ADMIN
  EDITOR
}

model TenantUser {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  passwordHash String
  name         String
  role         TenantRole @default(EDITOR)
  permissions  Json?      // fine-grained overrides, e.g. { "rfq.manage": true }
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  rfqAssignments Rfq[] @relation("AssignedTo")

  @@unique([tenantId, email]) // same email may exist across different tenants
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// WEBSITE / CMS
// ---------------------------------------------------------------------------

model Website {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template      String   @default("industrial") // industrial | engineering | corporate | technology | trading | services
  primaryColor  String   @default("#0B0D10")
  secondaryColor String  @default("#B8763E")
  accentColor   String   @default("#4A5568")
  logoUrl       String?
  logoDarkUrl   String?
  faviconUrl    String?
  headerStyle   String   @default("standard")
  footerStyle   String   @default("standard")
  seoTitle      String?
  seoDescription String?
  publishedAt   DateTime?
  updatedAt     DateTime @updatedAt

  pages  Page[]
  menus  Menu[]
  banners HeroBanner[]
}

model Page {
  id        String   @id @default(cuid())
  websiteId String
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  slug      String   // "about", "contact", etc — "" for home
  title     String
  status    String   @default("DRAFT") // DRAFT | REVIEW | APPROVED | PUBLISHED
  sections  Section[]
  seoTitle  String?
  seoDescription String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([websiteId, slug])
}

model Section {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // "hero" | "products-grid" | "verticals" | "testimonials" | ...
  order     Int      @default(0)
  visible   Boolean  @default(true)
  content   Json     // section-specific structured content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

model Menu {
  id        String     @id @default(cuid())
  websiteId String
  website   Website    @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  label     String     // "Primary", "Footer"
  items     MenuItem[]
}

model MenuItem {
  id       String  @id @default(cuid())
  menuId   String
  menu     Menu    @relation(fields: [menuId], references: [id], onDelete: Cascade)
  label    String
  url      String
  order    Int     @default(0)
  parentId String?
}

model HeroBanner {
  id          String   @id @default(cuid())
  websiteId   String
  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  heading     String
  subheading  String?
  desktopImg  String?
  mobileImg   String?
  videoUrl    String?
  ctaText     String?
  ctaUrl      String?
  order       Int      @default(0)
  enabled     Boolean  @default(true)
}

model MediaAsset {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String
  type      String   // image | video | pdf | document
  filename  String
  altText   String?
  tags      String[]
  createdAt DateTime @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// CATALOG: verticals, products, services, processes, equipment
// ---------------------------------------------------------------------------

model BusinessVertical {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  imageUrl    String?
  order       Int      @default(0)

  @@unique([tenantId, slug])
}

model ProductCategory {
  id       String    @id @default(cuid())
  tenantId String
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name     String
  slug     String
  products Product[]

  @@unique([tenantId, slug])
}

model Product {
  id            String           @id @default(cuid())
  tenantId      String
  tenant        Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      ProductCategory? @relation(fields: [categoryId], references: [id])
  name          String
  slug          String
  sku           String?
  shortDesc     String?
  fullDesc      String?
  specs         Json?
  images        String[]
  videoUrl      String?
  datasheetUrl  String?
  published     Boolean          @default(false)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  rfqItems RfqItem[]

  @@unique([tenantId, slug])
  @@index([tenantId, published])
}

model Service {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  slug      String
  description String?
  imageUrl  String?
  features  String[]
  order     Int      @default(0)

  @@unique([tenantId, slug])
}

model Process {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
}

model Equipment {
  id           String  @id @default(cuid())
  tenantId     String
  tenant       Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  manufacturer String?
  model        String?
  capacity     String?
  imageUrl     String?
}

model Certification {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  number      String?
  issuer      String?
  issueDate   DateTime?
  expiryDate  DateTime?
  imageUrl    String?
  pdfUrl      String?
}

model Client {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  logoUrl     String?
  industry    String?
  website     String?
}

model Testimonial {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author   String
  role     String?
  quote    String
}

model LeadershipProfile {
  id          String  @id @default(cuid())
  tenantId    String
  tenant      Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  designation String
  photoUrl    String?
  bio         String?
  linkedin    String?
  order       Int     @default(0)
}

// ---------------------------------------------------------------------------
// CAREERS
// ---------------------------------------------------------------------------

model JobOpening {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title        String
  department   String?
  location     String?
  type         String?       // full-time, contract...
  description  String?
  deadline     DateTime?
  isOpen       Boolean       @default(true)
  applications Application[]
  createdAt    DateTime      @default(now())
}

enum ApplicationStatus {
  NEW
  SCREENING
  SHORTLISTED
  INTERVIEW
  SELECTED
  REJECTED
  JOINED
}

model Application {
  id         String            @id @default(cuid())
  tenantId   String
  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobId      String
  job        JobOpening        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String?
  resumeUrl  String?
  status     ApplicationStatus @default(NEW)
  notes      String?
  createdAt  DateTime          @default(now())
}

// ---------------------------------------------------------------------------
// RFQ + QUOTATION
// ---------------------------------------------------------------------------

enum RfqStatus {
  NEW
  ACKNOWLEDGED
  UNDER_REVIEW
  TECHNICAL_REVIEW
  COSTING
  QUOTE_PREPARATION
  QUOTE_SENT
  NEGOTIATION
  ORDER_CONFIRMED
  IN_PRODUCTION
  QUALITY_INSPECTION
  DISPATCHED
  COMPLETED
  CANCELLED
}

model Rfq {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfqNumber     String       // human-readable, unique per tenant
  customerName  String
  company       String?
  email         String
  phone         String?
  country       String?
  message       String?
  status        RfqStatus    @default(NEW)
  assignedToId  String?
  assignedTo    TenantUser?  @relation("AssignedTo", fields: [assignedToId], references: [id])
  items         RfqItem[]
  attachments   RfqAttachment[]
  activity      RfqActivity[]
  quotations    Quotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([tenantId, rfqNumber])
  @@index([tenantId, status])
}

model RfqItem {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  quantity  Int
  material  String?
  targetPrice Decimal? @db.Decimal(12, 2)
  notes     String?
}

model RfqAttachment {
  id       String @id @default(cuid())
  rfqId    String
  rfq      Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  url      String
  filename String
}

model RfqActivity {
  id        String   @id @default(cuid())
  rfqId     String
  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  actor     String   // user name or "system" or "AI Assistant"
  action    String
  note      String?
  createdAt DateTime @default(now())
}

model Quotation {
  id           String          @id @default(cuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rfqId        String
  rfq          Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteNumber  String
  items        QuotationItem[]
  subtotal     Decimal         @db.Decimal(12, 2)
  tax          Decimal         @default(0) @db.Decimal(12, 2)
  freight      Decimal         @default(0) @db.Decimal(12, 2)
  discount     Decimal         @default(0) @db.Decimal(12, 2)
  total        Decimal         @db.Decimal(12, 2)
  validUntil   DateTime?
  terms        String?
  aiGenerated  Boolean         @default(false) // true if drafted by AI assistant
  approvedBy   String?         // human approver, required before sending — never auto-sent
  status       String          @default("DRAFT") // DRAFT | SENT | ACCEPTED | DECLINED
  createdAt    DateTime        @default(now())

  @@unique([tenantId, quoteNumber])
}

model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description String
  quantity    Int
  unitPrice   Decimal   @db.Decimal(12, 2)
  lineTotal   Decimal   @db.Decimal(12, 2)
}

// ---------------------------------------------------------------------------
// MISC TENANT DATA
// ---------------------------------------------------------------------------

model SocialLink {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform String
  url      String
}

model Location {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  label     String
  address   String
  lat       Float?
  lng       Float?
  isPrimary Boolean @default(false)
}

model ContactSubmission {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  createdAt DateTime @default(now())
}

model BlogPost {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  content   String
  status    String   @default("DRAFT")
  publishedAt DateTime?

  @@unique([tenantId, slug])
}

model Notification {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  tenantId       String?
  tenant         Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platformUserId String?
  platformUser   PlatformUser? @relation(fields: [platformUserId], references: [id])
  actorLabel     String        // resolved display name at time of action
  action         String
  entity         String?
  entityId       String?
  ip             String?
  createdAt      DateTime      @default(now())

  @@index([tenantId])
}
